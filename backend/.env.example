# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Keys stay on the server: the Expo/web app never sees them.

# ── LLM providers ─────────────────────────────────────────────────────────────
# Set one or both. If both are set, LLM_PROVIDER is tried first and the other is the fallback.
# Leaving a key as the placeholder below (or empty) means "not configured".

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Which provider to try first: gemini | groq
LLM_PROVIDER=gemini

# Max AI requests per minute across all clients (protects your key's quota)
AI_RATE_LIMIT_PER_MIN=20

# ── Existing settings ─────────────────────────────────────────────────────────
PORT=3001
# N8N_WEBHOOK_URL=

# ── Notes / RAG ───────────────────────────────────────────────────────────────
# Semantic search uses Gemini embeddings (same GEMINI_API_KEY). Without it, notes search by keyword only.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Where uploaded notes (chunks + embeddings) are stored. Default: ./data
# DATA_DIR=./data
