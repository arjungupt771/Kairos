        "responseBody": "={{ JSON.stringify({ ok: true, action: 'notified', sessionId: $json.sessionId, streak: $json.streak, coinsEarned: $json.coinsEarned }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Respond to Webhook (sent)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 200]
    }
  ],
