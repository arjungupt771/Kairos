              "value": "={{ $json.coinsEarned }}"
            },
            {
              "name": "totalCoins",
              "value": "={{ $json.totalCoins }}"
            },
            {
              "name": "focusMinutes",
              "value": "={{ $json.focusMinutes }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Send Notification (Mock / WhatsApp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200],
      "notes": "Replace this HTTP Request node with a WhatsApp node (AiSensy/Twilio/Meta) for real delivery.\nThe payload shape stays the same — just change the node type and credentials.\nFor WhatsApp: use $json.message as the message body, $json.studentId to look up the phone number."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, action: $json.skip ? 'skipped_duplicate' : 'notified', sessionId: $json.sessionId }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Respond to Webhook (skip)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 400]
    },
    {
      "parameters": {
