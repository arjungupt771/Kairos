{
  "name": "Alcovia Focus Session Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alcovia-session-complete",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Webhook - Session Complete",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "alcovia-session-complete"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ─── Idempotency Guard ─────────────────────────────────────────────────────\n// We store already-notified session IDs in n8n's static workflow data.\n// This is the second deduplication layer (backend is first).\n// Even if the webhook fires twice for the same sessionId, we only notify once.\n\nconst sessionId = $input.item.json.body?.sessionId || $input.item.json.sessionId;\n\nif (!sessionId) {\n  throw new Error('Missing sessionId in payload');\n}\n\n// Get the persistent dedup store for this workflow\nconst staticData = $getWorkflowStaticData('global');\n\nif (!staticData.notifiedSessions) {\n  staticData.notifiedSessions = {};\n}\n\n// Check if already notified\nif (staticData.notifiedSessions[sessionId]) {\n  // Already sent — skip\n  return [{\n    json: {\n      skip: true,\n      sessionId,\n      reason: 'Already notified for this session'\n    }\n  }];\n}\n\n// Mark as notified (persisted across executions)\nstaticData.notifiedSessions[sessionId] = {\n  notifiedAt: new Date().toISOString()\n};\n\n// Pass through payload enriched with flag\nconst payload = $input.item.json.body || $input.item.json;\nreturn [{\n  json: {\n    skip: false,\n    sessionId,\n    studentId: payload.studentId,\n    streak: payload.streak,\n    coinsEarned: payload.coinsEarned,\n    totalCoins: payload.totalCoins,\n    focusMinutes: payload.focusMinutes,\n    timestamp: payload.timestamp,\n    message: `🔥 Streak now ${payload.streak} day${payload.streak !== 1 ? 's' : ''}, +${payload.coinsEarned} coins earned! Total: ${payload.totalCoins} coins. Today's focus: ${payload.focusMinutes} minutes. Keep it up!`\n  }\n}];\n"
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Dedup + Enrich",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-skip-check",
              "leftValue": "={{ $json.skip }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Skip if duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/mock-n8n-sink",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "sessionId",
              "value": "={{ $json.sessionId }}"
            },
            {
              "name": "studentId",
              "value": "={{ $json.studentId }}"
            },
            {
